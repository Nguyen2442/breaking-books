// ==============================================================================
// AuraMind Production Prisma Schema
// PostgreSQL 16 + pgvector (Semantic Search) + JSONB (Structured Knowledge)
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, uuidOssp(map: "uuid-ossp")]
}

enum BookStatus {
  PENDING
  PARSING
  PROCESSING
  READY
  FAILED
}

enum ChapterStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Book {
  id          String     @id @default(uuid())
  title       String
  author      String?
  isbn        String?
  coverUrl    String?
  pageCount   Int?       @default(0)
  totalWords  Int?       @default(0)
  status      BookStatus @default(PENDING)
  sourceFile  String?    // Original file path or storage URL
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  chapters    Chapter[]

  @@index([status])
  @@index([createdAt])
  @@map("books")
}

model Chapter {
  id                    String        @id @default(uuid())
  bookId                String
  book                  Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterNumber         Int
  title                 String
  
  // SHA-256 Hash of raw chapter content for Global Caching Layer
  // If the same chapter is uploaded again or across books, AI cost is exactly $0
  contentHash           String        @db.VarChar(64)
  
  // Raw chapter text (2,000 - 4,000 words)
  rawText               String?       @db.Text
  wordCount             Int           @default(0)

  // Structured Knowledge Output stored as PostgreSQL JSONB
  // Contains: coreSummary, simplifiedExplanation, mindmap, actionableSteps, flashcards
  content               Json?

  status                ChapterStatus @default(PENDING)
  errorMessage          String?
  
  // Metadata tracking whether this was generated by Gemini or resolved via Global Cache
  isCached              Boolean       @default(false)
  cachedFromId          String?       // ID of the original chapter if re-used
  aiModelUsed           String?       // e.g. "gemini-3.5-flash"
  tokensUsed            Int?          @default(0)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  embeddings            ChapterEmbedding[]

  @@unique([bookId, chapterNumber])
  @@index([contentHash], name: "idx_chapters_content_hash")
  @@index([bookId])
  @@index([status])
  @@map("chapters")
}

model ChapterEmbedding {
  id         String   @id @default(uuid())
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  
  chunkIndex Int
  chunkText  String   @db.Text
  
  // 768-dimensional vector matching Google Gemini text-embedding-004
  // (or 1536 if using OpenAI text-embedding-3-small)
  embedding  Unsupported("vector(768)")?
  
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([chapterId])
  @@map("chapter_embeddings")
}
