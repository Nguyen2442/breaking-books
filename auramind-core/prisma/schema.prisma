// ==============================================================================
// AuraMind Production Prisma Schema
// PostgreSQL 16 + pgvector (Semantic Search) + JSONB (Structured Knowledge)
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, uuidOssp(map: "uuid-ossp")]
}

enum BookStatus {
  PENDING
  PARSING
  PROCESSING
  READY
  FAILED
}

enum ChapterStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  books            Book[]
  flashcardReviews FlashcardReview[]
  actionItems      ActionItem[]

  @@map("users")
}

model Book {
  id          String      @id @default(uuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  author      String?
  isbn        String?
  coverUrl    String?
  pageCount   Int?        @default(0)
  totalWords  Int?        @default(0)
  status      BookStatus  @default(PENDING)
  sourceFile  String?     // Original file path or storage URL
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  chapters    Chapter[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("books")
}

model Chapter {
  id                    String             @id @default(uuid())
  bookId                String
  book                  Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterNumber         Int
  title                 String
  
  // SHA-256 Hash of raw chapter content for Global Caching Layer
  contentHash           String             @db.VarChar(64)
  
  // Raw chapter text (2,000 - 4,000 words)
  rawText               String?            @db.Text
  wordCount             Int                @default(0)

  // Structured Knowledge Output stored as PostgreSQL JSONB
  // Contains: coreSummary, simplifiedExplanation, mindmap, actionableSteps, flashcards
  content               Json?

  status                ChapterStatus      @default(PENDING)
  errorMessage          String?
  
  // Metadata tracking whether this was generated by Gemini or resolved via Global Cache
  isCached              Boolean            @default(false)
  cachedFromId          String?            // ID of the original chapter if re-used
  aiModelUsed           String?            // e.g. "gemini-3.5-flash"
  tokensUsed            Int?               @default(0)

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  embeddings            ChapterEmbedding[]
  flashcardReviews      FlashcardReview[]
  actionItems           ActionItem[]

  @@unique([bookId, chapterNumber])
  @@index([contentHash], name: "idx_chapters_content_hash")
  @@index([bookId])
  @@index([status])
  @@map("chapters")
}

model ChapterEmbedding {
  id         String   @id @default(uuid())
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  
  chunkIndex Int
  chunkText  String   @db.Text
  
  // 768-dimensional vector matching Google Gemini text-embedding-004
  embedding  Unsupported("vector(768)")?
  
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([chapterId])
  @@map("chapter_embeddings")
}

// ==============================================================================
// Adaptive Spaced Repetition Engine (SM-2 Learning Loop)
// ==============================================================================

model FlashcardReview {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId      String
  chapter        Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  question       String    @db.Text
  answer         String    @db.Text
  tip            String?   @db.Text

  // SM-2 Algorithm parameters
  interval       Int       @default(1)    // Review interval in days (e.g. 1, 3, 7, 30, 90)
  easeFactor     Float     @default(2.5)  // Easiness factor (minimum 1.3)
  repetitions    Int       @default(0)    // Consecutive successful reviews
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, nextReviewAt])
  @@index([chapterId])
  @@map("flashcard_reviews")
}

// ==============================================================================
// Action Engine (Actionable Steps & Habits Tracker)
// ==============================================================================

model ActionItem {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId       String
  chapter         Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  stepNumber      Int
  action          String       @db.Text
  practicalTips   String?      @db.Text
  status          ActionStatus @default(PENDING)
  dueDate         DateTime?
  reflectionNotes String?      @db.Text

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, status])
  @@index([chapterId])
  @@map("action_items")
}
