# Database Connection (PostgreSQL 16 + pgvector)
POSTGRES_USER=auramind
POSTGRES_PASSWORD=auramind_secure_password
POSTGRES_DB=auramind
POSTGRES_PORT=5432
DATABASE_URL="postgresql://auramind:auramind_secure_password@localhost:5432/auramind?schema=public"

# Redis (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=auramind_redis_pass

# Application
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_me_in_prod

# Google Gemini AI Engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
