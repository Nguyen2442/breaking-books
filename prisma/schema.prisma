// ==============================================================================
// AuraMind Production Prisma Schema
// PostgreSQL 16 + pgvector (Semantic Search) + JSONB (Structured Knowledge)
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, uuidOssp(map: "uuid-ossp")]
}

enum BookStatus {
  PENDING
  PARSING
  PROCESSING
  READY
  FAILED
}

enum ChapterStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Book {
  id          String     @id @default(uuid())
  title       String
  author      String?
  isbn        String?
  coverUrl    String?
  pageCount   Int?       @default(0)
  totalWords  Int?       @default(0)
  status      BookStatus @default(PENDING)
  sourceFile  String?    // Original file path or storage URL
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  chapters    Chapter[]

  @@index([status])
  @@index([createdAt])
  @@map("books")
}

model Chapter {
  id                    String        @id @default(uuid())
  bookId                String
  book                  Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterNumber         Int
  title                 String
  
  // SHA-256 Hash of raw chapter content for Global Caching Layer
  // If the same chapter is uploaded again or across books, AI cost is exactly $0
  contentHash           String        @db.VarChar(64)
  
  // Raw chapter text (2,000 - 4,000 words)
  rawText               String?       @db.Text
  wordCount             Int           @default(0)

  // Structured Knowledge Output stored as PostgreSQL JSONB
  // Contains: coreSummary, simplifiedExplanation, mindmap, actionableSteps, flashcards
  content               Json?

  status                ChapterStatus @default(PENDING)
  errorMessage          String?
  
  // Metadata tracking whether this was generated by Gemini or resolved via Global Cache
  isCached              Boolean       @default(false)
  cachedFromId          String?       // ID of the original chapter if re-used
  aiModelUsed           String?       // e.g. "gemini-3.5-flash"
  tokensUsed            Int?          @default(0)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  embeddings            ChapterEmbedding[]

  @@unique([bookId, chapterNumber])
  @@index([contentHash], name: "idx_chapters_content_hash")
  @@index([bookId])
  @@index([status])
  @@map("chapters")
}

model ChapterEmbedding {
  id         String   @id @default(uuid())
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  
  chunkIndex Int
  chunkText  String   @db.Text
  
  // 768-dimensional vector matching Google Gemini text-embedding-004
  // (or 1536 if using OpenAI text-embedding-3-small)
  embedding  Unsupported("vector(768)")?
  
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([chapterId])
  @@map("chapter_embeddings")
}

// ==============================================================================
// Domain Knowledge Base & Dynamic Prompt Management Engine
// Enables ongoing data collection, keyword expansion, and non-hardcoded prompts
// ==============================================================================

model DomainKnowledge {
  id                     String           @id @default(uuid())
  domainKey              String           @unique // e.g. "software", "marketing", "finance", "business", "psychology"
  nameVi                 String
  nameEn                 String
  roleName               String
  perspective            String
  keywords               Json             // Array of strings / keywords for matching
  foundationalPrinciples Json?            // Array of core principles / mental models
  coreGuidance           String           @db.Text
  calloutContext         String           @db.Text
  keyMetrics             Json?            // Array of domain metric names
  widgetLabBlueprint     Json?            // Interactive lab nodes, slider, actions, stats
  quizContext            String?          @db.Text
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  promptTemplates        PromptTemplate[]
  crawledTerms           CrawledTerm[]

  @@index([domainKey])
  @@index([isActive])
  @@map("domain_knowledge")
}

model PromptTemplate {
  id                String           @id @default(uuid())
  key               String           // e.g. "chapter-break", "mindmap", "active-recall"
  domainKey         String?          // Null = global default; or specific domainKey
  domain            DomainKnowledge? @relation(fields: [domainKey], references: [domainKey], onDelete: SetNull)
  version           Int              @default(1)
  name              String
  systemInstruction String           @db.Text
  promptTemplate    String           @db.Text // Contains {{bookTitle}}, {{targetCh}}, {{domainRole}}, etc.
  parameters        Json?            // { temperature: 0.15, maxOutputTokens: 32768, json: true }
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([key, domainKey, version])
  @@index([key, domainKey])
  @@index([isActive])
  @@map("prompt_templates")
}

model CrawledTerm {
  id            String           @id @default(uuid())
  domainKey     String
  domain        DomainKnowledge? @relation(fields: [domainKey], references: [domainKey], onDelete: Cascade)
  term          String
  viTranslation String?
  definition    String?          @db.Text
  caseStudy     String?          @db.Text
  source        String?          @default("crawler") // "crawler" | "manual-input" | "gemini-extracted"
  confidence    Float?           @default(1.0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([domainKey])
  @@index([term])
  @@map("crawled_terms")
}
